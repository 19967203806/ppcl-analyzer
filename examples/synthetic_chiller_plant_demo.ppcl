00010 C SYNTHETIC CHILLED WATER PLANT DEMONSTRATION PROGRAM
00020 C NOT FROM A REAL FACILITY OR PRODUCTION CONTROL SYSTEM
00030 C SCOPE: PLANT ENABLE, SAFETY INTERLOCKS, PUMP CONTROL, CHILLER STAGING, ALARMS
00040 C EQUIPMENT: 1 CHILLER, 1 CHW PUMP, 1 CONDENSER PUMP, 1 COOLING TOWER
00050 C PROGRAM INDEX
00060 C 00100-00990 INITIALIZATION AND MAIN LOOP
00070 C 01000-01990 PLANT ENABLE LOGIC
00080 C 02000-02990 SAFETY INTERLOCKS
00090 C 03000-03990 EQUIPMENT CONTROL
00100 C 04000-04990 ALARM AND STATUS

00200 SET $INIT=0
00210 SET $PLANT.EN=0
00220 SET $PLANT.REQ=0
00230 SET $PLANT.READY=0
00240 SET $PLANT.FLT=0
00250 SET $SAFETY.OK=1
00260 SET $START.DLY=30
00270 SET $STOP.DLY=90
00280 SET $CHW.SP=6.5
00290 SET $DP.SP=80.0
00300 SET $FREEZE.SP=3.0
00310 SET $HI.PRESS.SP=1800.0
00320 SET $LOW.FLOW.SP=20.0
00330 SET $INIT=1

00500 SAMPLE(5) GOSUB 01000
00510 SAMPLE(10) GOSUB 02000
00520 SAMPLE(10) GOSUB 03000
00530 SAMPLE(30) GOSUB 04000
00540 GOTO 00500

01000 C PLANT ENABLE LOGIC
01010 IF %BLDG.FIRE.ALM THEN GOTO 01800
01020 IF %PLANT.EMSTOP THEN GOTO 01800
01030 IF %PLANT.MAN.EN THEN GOTO 01100
01040 IF %BLDG.OCC THEN GOTO 01100
01050 IF %AHU.CLG.REQ > 2 THEN GOTO 01100
01060 GOTO 01600

01100 SET $PLANT.REQ=1
01110 IF %OAT < 8.0 THEN GOTO 01200
01120 IF %CHWR.TEMP > 14.0 THEN GOTO 01300
01130 IF %AHU.CLG.REQ > 0 THEN GOTO 01300
01140 GOTO 01600

01200 IF %CHWR.TEMP > 16.0 THEN GOTO 01300
01210 GOTO 01600

01300 SET $PLANT.EN=1
01310 SET $PLANT.STOP.TIM=0
01320 IF $PLANT.START.TIM >= $START.DLY THEN GOTO 01400
01330 SET $PLANT.START.TIM=$PLANT.START.TIM+5
01340 RETURN
01400 SET $PLANT.READY=1
01410 RETURN

01600 SET $PLANT.REQ=0
01610 SET $PLANT.START.TIM=0
01620 IF $PLANT.STOP.TIM >= $STOP.DLY THEN GOTO 01700
01630 SET $PLANT.STOP.TIM=$PLANT.STOP.TIM+5
01640 RETURN
01700 SET $PLANT.EN=0
01710 SET $PLANT.READY=0
01720 RETURN

01800 SET $PLANT.REQ=0
01810 SET $PLANT.EN=0
01820 SET $PLANT.READY=0
01830 SET $PLANT.FLT=1
01840 RETURN

02000 C SAFETY INTERLOCKS
02010 SET $SAFETY.OK=1
02020 IF %BLDG.FIRE.ALM THEN GOTO 02800
02030 IF %PLANT.EMSTOP THEN GOTO 02800
02040 IF %CHWS.TEMP < $FREEZE.SP THEN GOTO 02800
02050 IF %CHW.HDR.PRESS > $HI.PRESS.SP THEN GOTO 02800
02060 IF %CHW.FLOW < $LOW.FLOW.SP THEN GOTO 02100
02070 SET $LOW.FLOW.TIM=0
02080 GOTO 02200
02100 SET $LOW.FLOW.TIM=$LOW.FLOW.TIM+10
02110 IF $LOW.FLOW.TIM > 60 THEN GOTO 02800
02200 IF %CH1.FLT THEN GOTO 02800
02210 IF %PCHW1.FLT THEN GOTO 02800
02220 SET $PLANT.FLT=0
02230 RETURN

02800 SET $SAFETY.OK=0
02810 SET $PLANT.FLT=1
02820 OFF %CH1.CMD
02830 OFF %PCHW1.CMD
02840 OFF %PCW1.CMD
02850 OFF %CT1.CMD
02860 RETURN

03000 C EQUIPMENT CONTROL
03010 IF NOT $PLANT.READY THEN GOTO 03800
03020 IF NOT $SAFETY.OK THEN GOTO 03800
03030 ON %PCHW1.CMD
03040 ON %PCW1.CMD
03050 ON %CT1.CMD
03060 LOOP(0,"%CHW.DP","%PCHW.VFD.CMD","$DP.SP","$PCHW.PG","$PCHW.IG",0,5,0,25.0,100.0,0)
03070 IF %CHWS.TEMP > $CHW.SP+1.0 THEN ON %CH1.CMD
03080 IF %CHWS.TEMP < $CHW.SP-0.5 THEN OFF %CH1.CMD
03090 RETURN

03800 OFF %CH1.CMD
03810 OFF %PCHW1.CMD
03820 OFF %PCW1.CMD
03830 OFF %CT1.CMD
03840 SET %PCHW.VFD.CMD=0
03850 RETURN

04000 C ALARM AND STATUS
04010 SET %PLANT.EN.STS=$PLANT.EN
04020 SET %PLANT.REQ.STS=$PLANT.REQ
04030 SET %PLANT.FLT.STS=$PLANT.FLT
04040 IF NOT $SAFETY.OK THEN ON %PLANT.ALM
04050 IF $SAFETY.OK AND NOT $PLANT.FLT THEN OFF %PLANT.ALM
04060 RETURN
