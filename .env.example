# Model provider: qwen or azure
MODEL_PROVIDER=qwen
MODEL_NAME=qwen-plus
OPENAI_API_KEY=your-dashscope-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_REQUEST_TIMEOUT=600
MODEL_MAX_RETRIES=0

# Azure is retained as an optional provider.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# Auth session token lifetime in hours (default 168 = 7 days)
AUTH_TOKEN_TTL_HOURS=168

# Local demonstration account. Change both values before any shared deployment.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=ppcl-local-admin-2026

# Per-user daily limits on model-backed requests (0 or empty = unlimited).
# Set these on any public demo to cap model spending.
DAILY_ANALYSIS_LIMIT=0
DAILY_CHAT_LIMIT=0

# Bind locally by default. Change only behind approved network controls.
API_HOST=127.0.0.1
API_PORT=8000

# Optional frontend override
BACKEND_URL=http://localhost:8000

# Optional LangSmith tracing. Leave disabled for local-only execution.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ppcl-flowchart
